{
  "name": "online-shop",
  "version": "1.0.29",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "prestart": "npm run demo:admin:setup",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "qa": "npm run test && npm run lint && npm run typecheck && npm run db:schema:check && npm run db:migrations:check",
    "postinstall": "prisma generate",
    "db:deploy": "prisma db push --accept-data-loss",
    "db:status": "prisma validate",
    "db:schema:check": "node scripts/validate-prisma.mjs",
    "db:dev:push": "prisma db push",
    "db:dev:sync": "node scripts/sync-prisma.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env prisma/seed.mjs",
    "db:dev:setup": "prisma generate && prisma db push && npm run db:seed",
    "demo:admin:setup": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/bootstrap-test-admin.mjs",
    "db:super-admins": "node scripts/setup-super-admins.mjs",
    "db:fix-legacy-orders": "node scripts/fix-legacy-order-enums.mjs",
    "db:repair-order-reservations": "node scripts/repair-order-inventory-reservations.mjs",
    "db:repair-site-design": "node scripts/repair-site-design.mjs",
    "db:migrations:check": "node scripts/check-migration-layout.mjs",
    "db:repair-cms": "node scripts/repair-cms-migration-state.mjs",
    "dev:repair": "node scripts/repair-site-design.mjs && prisma generate && next dev",
    "email:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-email-config.mjs",
    "courier:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-courier-config.mjs",
    "epay:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-epay-config.mjs",
    "production:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-production-readiness.mjs",
    "predeploy:check": "node scripts/final-predeploy-check.mjs",
    "db:audit": "node scripts/audit-database-consistency.mjs",
    "db:repair-product-sections": "node scripts/repair-product-category-sections.mjs",
    "demo:setup": "prisma generate && prisma db push --accept-data-loss && npm run db:seed",
    "vercel:build": "prisma generate && prisma db push --accept-data-loss && npm run db:seed && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.2",
    "cloudinary": "^2.10.0",
    "jose": "^6.2.4",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.0",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.35.0",
    "@img/sharp-libvips-linux-x64": "1.3.0"
  }
}
