# ==========================================================
# PUBLIC DEMO — GitHub + Vercel + Neon PostgreSQL
# Never commit real secrets or the real Neon URL to GitHub.
# ==========================================================

# Neon: use the pooled PostgreSQL connection string for application traffic.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Public application URL. Replace after the first Vercel deployment.
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
APP_URL="https://your-project.vercel.app"

# Authentication/session secrets — generate long random values in Vercel.
AUTH_SECRET="replace-with-a-long-random-value"
SESSION_SECRET="replace-with-a-long-random-value"

STORE_NAME="Online Store"
NEXT_PUBLIC_STORE_PHONE=""

# Public demo mode
DEMO_MODE="true"
DEMO_DATA_TTL_MINUTES="30"

# Public demo SUPER_ADMIN
CREATE_TEST_ADMIN="true"
TEST_ADMIN_USERNAME="admin"
TEST_ADMIN_PASSWORD="admin"
TEST_ADMIN_EMAIL="admin@example.local"
TEST_ADMIN_DISPLAY_NAME="Админ"

# Used by /api/internal/demo-cleanup and Vercel/external cron.
CRON_SECRET="replace-with-a-long-random-value"

# Cloudinary (leave blank until configured)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER_PREFIX="online-store-demo"

# Transactional email — keep in test mode for public demo unless intentionally configured.
RESEND_API_KEY=""
RESEND_TEST_MODE="true"
RESEND_TEST_RECIPIENT=""
EMAIL_BRAND_NAME="Online Store"
EMAIL_FROM=""
EMAIL_REPLY_TO=""
EMAIL_SUPPORT=""
EMAIL_ORDERS=""
ADMIN_NOTIFICATION_EMAILS=""
CONTACT_RECIPIENT_EMAILS=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-project.vercel.app/api/auth/google/callback"

# Company details fallback; database Legal Settings take precedence
LEGAL_COMPANY_NAME=""
LEGAL_COMPANY_ID=""
LEGAL_VAT_NUMBER=""
LEGAL_DEFAULT_VAT_RATE="20"
LEGAL_COMPANY_ADDRESS=""
LEGAL_CORRESPONDENCE_ADDRESS=""
LEGAL_CONTACT_EMAIL=""
LEGAL_CONTACT_PHONE=""
LEGAL_REPRESENTATIVE_NAME=""

# Initial administration bootstrap
BOOTSTRAP_SUPER_ADMIN_EMAILS=""
BOOTSTRAP_ALLOW_UNVERIFIED="false"

# Shipping defaults
SHIPPING_FREE_THRESHOLD_EUR="120"
SHIPPING_FALLBACK_ENABLED="false"
NEXT_PUBLIC_SHIPPING_FALLBACK_PRICE_EUR=""
DEFAULT_SHIPMENT_WEIGHT_KG="1"
COD_ORDER_RESERVATION_HOURS="24"

# Econt — DEMO only for the public showcase
ECONT_ENV="demo"
ECONT_USERNAME=""
ECONT_PASSWORD=""
ECONT_SENDER_NAME=""
ECONT_SENDER_PHONE=""
ECONT_SENDER_OFFICE_CODE=""
ECONT_SENDER_CITY=""
ECONT_SENDER_POST_CODE=""
ECONT_SENDER_STREET=""
ECONT_SENDER_STREET_NUMBER=""

# Speedy — DEMO only for the public showcase
SPEEDY_ENV="demo"
SPEEDY_USERNAME=""
SPEEDY_PASSWORD=""
SPEEDY_SENDER_CLIENT_ID=""
SPEEDY_SERVICE_ID=""

# ePay — DEMO only; do not use production credentials in a public demo
EPAY_ENV="demo"
EPAY_MIN=""
EPAY_SECRET=""
EPAY_NOTIFICATION_URL=""
